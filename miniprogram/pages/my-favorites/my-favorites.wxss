.page-container {
  padding-bottom: 60rpx;
}

.recipe-grid {
  padding: 20rpx 30rpx;
}

.recipe-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.recipe-card:active {
  opacity: 0.85;
}

.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.recipe-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.fav-icon {
  font-size: 108rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  line-height: 1;
}

.fav-icon.fav-active {
  color: var(--danger);
}

.recipe-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.stat {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.stat-divider {
  color: var(--border);
}

.recipe-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #FFF5EB;
  font-size: 22rpx;
  color: var(--primary-light);
}

.empty-state {
  text-align: center;
  padding: 120rpx 30rpx;
  color: var(--text-light);
}

.empty-state text {
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  margin-top: 16rpx;
  color: var(--text-light);
}
