<view class="page-container">
  <view wx:if="{{recipes.length === 0 && !loading}}" class="empty-state">
    <text>还没有收藏食谱</text>
    <text class="empty-hint">在食谱列表中点击 ♡ 即可收藏</text>
  </view>

  <view class="recipe-grid">
    <view class="recipe-card" wx:for="{{recipes}}" wx:key="_id" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="recipe-info">
        <view class="recipe-header">
          <text class="recipe-title">{{item.title}}</text>
          <text class="fav-icon fav-active" catchtap="removeFav" data-id="{{item._id}}">♥</text>
        </view>
        <view class="recipe-stats">
          <text class="stat">{{item.calorie}} kcal</text>
          <text class="stat-divider">|</text>
          <text class="stat">蛋白质 {{item.protein_g}}g</text>
        </view>
        <view class="recipe-tags">
          <text class="mini-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="disclaimer">本内容由AI生成，仅供参考，不构成医疗建议</view>
</view>
