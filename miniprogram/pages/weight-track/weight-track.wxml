<view class="page-container">
  <view class="card weight-current">
    <text class="weight-label">最新体重</text>
    <text class="weight-value">{{latestWeightDisplay}} <text class="weight-unit">kg</text></text>
    <text class="weight-change" wx:if="{{weightChangeDisplay}}">
      {{weightChangeDisplay}} kg
    </text>
  </view>

  <view class="card">
    <text class="section-title-inner">记录新体重</text>
    <view class="weight-input-row">
      <input class="input-number weight-input" type="digit" placeholder="输入体重" value="{{inputWeight}}" bindinput="onWeightInput" maxlength="6" />
      <text class="weight-unit-label">kg</text>
    </view>
    <button class="btn-primary weight-save-btn" bindtap="saveWeight" disabled="{{!inputWeight || saving}}">
      <text wx:if="{{!saving}}">记录</text>
      <text wx:if="{{saving}}">保存中...</text>
    </button>
  </view>

  <view class="card" wx:if="{{records.length > 1}}">
    <text class="section-title-inner">体重趋势</text>
    <canvas class="chart-canvas" type="2d" id="weightChart"></canvas>
  </view>

  <view class="card">
    <text class="section-title-inner">历史记录</text>
    <view wx:for="{{recordsReversed}}" wx:key="index" class="record-item">
      <text class="record-date">{{item.date}}</text>
      <text class="record-weight">{{item.weight_kg_display}} kg</text>
    </view>
    <view wx:if="{{records.length === 0}}" class="empty-records">
      <text>还没有体重记录</text>
    </view>
  </view>

  <view class="disclaimer">以上内容仅供参考，不构成医疗建议</view>
</view>
