<view class="page-container">
  <view wx:if="{{loading}}" class="loading-state">
    <text class="loading-text">生成战绩卡片中...</text>
    <text class="loading-sub">让我看看你今天有多努力</text>
  </view>

  <view wx:elif="{{error}}" class="error-state">
    <text class="error-text">出错了</text>
    <text class="error-msg">{{error}}</text>
    <button class="retry-btn" bindtap="loadData">重新生成</button>
  </view>

  <view wx:else class="card-wrapper">
    <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

    <view class="actions">
      <view class="action-btn save-btn" bindtap="saveToAlbum" hover-class="btn-hover">保存到相册</view>
      <view class="action-btn back-btn" bindtap="goBack" hover-class="btn-hover">返回首页</view>
    </view>
  </view>
</view>
