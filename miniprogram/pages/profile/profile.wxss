.page-container {
  padding-bottom: 60rpx;
}

.user-card {
  text-align: center;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.user-stat {
  text-align: center;
}

.us-val {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.us-label {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.bmi-display {
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--card-bg-light);
}

.bmi-value {
  font-size: 44rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.bmi-status {
  font-size: 32rpx;
}

.bmi-status.danger {
  color: var(--danger);
}

.bmi-status.warning {
  color: var(--warning);
}

.bmi-status.normal {
  color: var(--success);
}

.bmi-status.info {
  color: var(--text-secondary);
}

.bmi-range-wrap {
  position: relative;
  margin-top: 16rpx;
  padding-bottom: 48rpx;
}

.bmi-range-bar {
  display: flex;
  height: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: var(--card-bg-light);
}

.bmi-range-seg {
  height: 100%;
}

.seg-under {
  background: var(--warning);
}

.seg-normal {
  background: var(--success);
}

.seg-over {
  background: var(--color-accent-orange);
}

.bmi-marker {
  position: absolute;
  top: -10rpx;
  width: 6rpx;
  height: 44rpx;
  border-radius: 3rpx;
  background: var(--text-primary);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.9);
  transform: translateX(-50%);
}

.bmi-range-bound {
  position: absolute;
  top: 36rpx;
  font-size: 24rpx;
  color: var(--text-light);
  transform: translateX(-50%);
}

.bmi-range-labels {
  display: flex;
  margin-top: 2rpx;
}

.bmi-range-label {
  text-align: center;
  font-size: 32rpx;
  color: var(--text-light);
}

.section-title-inner {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.target-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.target-item:last-child {
  border-bottom: none;
}

.target-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.target-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger {
  color: var(--danger);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-light);
}

.health-tip-card {
  background: #FFFBE6;
  border-left: 8rpx solid var(--color-accent-yellow);
}

.health-tip-header {
  margin-bottom: 20rpx;
}

.health-tip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.health-tip-content {
  padding-top: 16rpx;
  border-top: 1rpx solid #E6D9A8;
}

.health-tip-item {
  display: block;
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.health-tip-item:last-child {
  margin-bottom: 0;
}

.health-tip-strong {
  font-weight: bold;
  color: #333333;
}
