.page-container {
  padding-bottom: 60rpx;
}

.user-card {
  text-align: center;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}

.user-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.user-stat {
  text-align: center;
}

.us-val {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.us-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.bmi-display {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F8F4EC;
}

.bmi-value {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.bmi-status {
  font-size: 26rpx;
}

.bmi-status.danger {
  color: var(--danger);
}

.bmi-status.warning {
  color: var(--warning);
}

.bmi-status.normal {
  color: var(--success);
}

.bmi-status.info {
  color: var(--text-secondary);
}

.section-title-inner {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.target-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.target-item:last-child {
  border-bottom: none;
}

.target-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.target-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.danger {
  color: var(--danger);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-light);
}

.health-info-content {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.health-info-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.reminder-hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}
