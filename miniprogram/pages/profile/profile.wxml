<view class="page-container">
  <view class="card user-card" wx:if="{{user}}">
    <text class="user-name">我的档案</text>
    <view class="user-stats">
      <view class="user-stat">
        <text class="us-val">{{user.height_cm}}</text>
        <text class="us-label">身高 cm</text>
      </view>
      <view class="user-stat">
        <text class="us-val">{{currentWeightDisplay}}</text>
        <text class="us-label">当前体重 kg</text>
      </view>
      <view class="user-stat">
        <text class="us-val">{{targetWeightDisplay}}</text>
        <text class="us-label">目标体重 kg</text>
      </view>
    </view>

    <view class="bmi-display" wx:if="{{bmi}}">
      <text class="bmi-value">BMI {{bmi}}</text>
      <text class="bmi-status {{healthWarning.level}}">{{healthWarning.text}}</text>
      <view class="bmi-range-wrap">
        <view class="bmi-range-bar">
          <view class="bmi-range-seg seg-under" style="width: {{bmiBar.under}};"></view>
          <view class="bmi-range-seg seg-normal" style="width: {{bmiBar.normal}};"></view>
          <view class="bmi-range-seg seg-over" style="width: {{bmiBar.over}};"></view>
        </view>
        <view class="bmi-marker" style="left: {{markerLeft}};"></view>
        <view class="bmi-range-bound" style="left: {{bound18}};">18.5</view>
        <view class="bmi-range-bound" style="left: {{bound24}};">24</view>
      </view>
      <view class="bmi-range-labels">
        <text class="bmi-range-label" style="width: {{bmiBar.under}};">偏瘦</text>
        <text class="bmi-range-label" style="width: {{bmiBar.normal}};">正常</text>
        <text class="bmi-range-label" style="width: {{bmiBar.over}};">偏高</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{user}}">
    <text class="section-title-inner">每日目标</text>
    <view class="target-item">
      <text class="target-label">热量目标</text>
      <text class="target-value">{{user.daily_calorie_target}} kcal</text>
    </view>
    <view class="target-item">
      <text class="target-label">蛋白质目标</text>
      <text class="target-value">{{user.daily_protein_target_g}} g</text>
    </view>
    <view class="target-item">
      <text class="target-label">活动水平</text>
      <text class="target-value">{{activityLabel}}</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item danger" bindtap="confirmResetData">
      <text>重置为新用户</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card health-tip-card">
    <view class="health-tip-header">
      <text class="health-tip-title">⚠️ 健康提示</text>
    </view>
    <view class="health-tip-content">
      <view class="health-tip-item">💡 本应用提供的信息仅供参考，<text class="health-tip-strong">不构成医疗建议</text></view>
      <view class="health-tip-item">⚠️ 如果你有甲亢、糖尿病、消化道疾病等健康问题，<text class="health-tip-strong">请先咨询医生</text></view>
      <view class="health-tip-item">💡 食物热量估算可能存在一定误差</view>
      <view class="health-tip-item">💡 建议逐步增重，每周 0.5~1kg 为宜</view>
      <view class="health-tip-item">💡 本产品面向 18 岁以上用户</view>
    </view>
  </view>

  <view class="disclaimer">以上健康信息仅供参考，不构成医疗建议</view>
</view>
