.page-container {
  padding-bottom: 60rpx;
}

.hero-banner {
  background: var(--primary-gradient);
  margin: 0;
  padding: 60rpx 40rpx 50rpx;
  position: relative;
  overflow: hidden;
}

.hero-banner::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.hero-banner::before {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.hero-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  position: relative;
  z-index: 1;
}

.hero-greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 12rpx;
  line-height: 1.4;
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  position: relative;
  z-index: 1;
  animation: pop 0.5s ease;
}

.progress-rings {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: -40rpx 0 20rpx;
  position: relative;
  z-index: 2;
}

.ring-wrapper {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 24rpx rgba(255, 122, 47, 0.12);
  padding: 12rpx;
}

.ring-canvas {
  width: 236rpx;
  height: 236rpx;
}

.ring-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 200rpx;
}

.ring-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.ring-unit {
  font-size: 22rpx;
  color: var(--text-light);
}

.ring-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  font-weight: 600;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 30rpx 10rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transition: transform 0.15s;
}

.action-btn:active .action-icon {
  transform: scale(0.9);
}

.action-icon-orange {
  background: var(--primary-gradient);
}

.action-icon-green {
  background: linear-gradient(135deg, #2ECC71, #A8E6CF);
}

.action-icon-coral {
  background: linear-gradient(135deg, #FF6B6B, #FF9B9B);
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 30rpx 30rpx 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-light);
}

.empty-state {
  text-align: center;
  padding: 60rpx 30rpx;
  margin: 10rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 122, 47, 0.08);
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  background: var(--card-gradient-1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--text-light);
  display: block;
}

.meal-card {
  border-radius: 24rpx;
  margin: 12rpx 30rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 122, 47, 0.08);
  animation: slideUp 0.3s ease both;
}

.meal-card:nth-child(3) { animation-delay: 0s; }
.meal-card:nth-child(4) { animation-delay: 0.05s; }
.meal-card:nth-child(5) { animation-delay: 0.1s; }
.meal-card:nth-child(6) { animation-delay: 0.15s; }

.meal-breakfast { background: linear-gradient(135deg, #FFF5EB, #FFE8D0); }
.meal-lunch { background: linear-gradient(135deg, #FFF0F0, #FFE0E0); }
.meal-dinner { background: linear-gradient(135deg, #F0E6FF, #E0D0F5); }
.meal-snack { background: linear-gradient(135deg, #FFF8E0, #FFEEB0); }

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.meal-type-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.meal-time {
  font-size: 24rpx;
  color: var(--text-light);
}

.meal-items {
  padding-top: 10rpx;
}

.food-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.food-item:last-child {
  padding-bottom: 0;
}

.food-name {
  color: var(--text-primary);
}

.food-cal {
  color: var(--text-secondary);
  font-weight: 500;
}

.meal-total {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}
