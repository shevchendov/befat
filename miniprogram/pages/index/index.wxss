.page-container {
  padding-bottom: 60rpx;
}

/* ========== 顶部品牌区 ========== */
.hero-banner {
  background: var(--color-primary);
  margin: 0;
  padding: 60rpx 40rpx 50rpx;
  position: relative;
  overflow: hidden;
}

.hero-banner::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.hero-banner::before {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.hero-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  position: relative;
  z-index: 1;
}

/* 顶部"我的"入口：复用 hero-badge 半透明白胶囊风格，右上角绝对定位 */
.hero-profile-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 2;
  padding: 8rpx 22rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

.hero-profile-btn-hover {
  opacity: 0.85;
}

.hero-greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 12rpx;
  line-height: 1.4;
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  position: relative;
  z-index: 1;
  animation: pop 0.5s ease;
}

.hero-badge-sprint {
  background: rgba(255,255,255,0.18);
  opacity: 0.9;
}

/* ========== 进度环 ========== */
.progress-rings {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: -40rpx 0 20rpx;
  position: relative;
  z-index: 2;
}

.ring-wrapper {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  background: var(--card-bg-white);
  border: var(--border-width) solid var(--color-border);
  border-radius: 50%;
  box-shadow: var(--shadow-card);
  padding: 12rpx;
}

.ring-canvas {
  width: 236rpx;
  height: 236rpx;
}

.ring-center {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.ring-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.ring-value {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.ring-unit {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.ring-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

.ring-sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-light);
}

.ring-sub-warn {
  color: #FF4D4F;
  font-weight: 600;
}

/* ========== 快捷操作（贴纸按钮） ========== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 30rpx 10rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 110rpx;
  height: 110rpx;
  background: #FFF2E6;
  border: 3rpx solid #D9773B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s;
}

.action-icon-orange {
  background: #FFF2E6;
  border-color: #D9773B;
}

.action-icon-green {
  background: #FDF0E6;
  border-color: #C76B3E;
}

.action-icon-coral {
  background: #FFF2E6;
  border-color: #A86032;
}

.action-btn:active .action-icon {
  transform: scale(0.9);
}

.action-label {
  font-size: 24rpx;
  color: #664A38;
  font-weight: 500;
}

/* ========== 餐食列表标题 ========== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 30rpx 30rpx 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 60rpx 30rpx;
  margin: 10rpx 30rpx;
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  background: var(--card-bg-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-light);
  display: block;
}

/* ========== 餐食卡片 ========== */
.meal-card {
  margin: 12rpx 30rpx;
  padding: 24rpx 28rpx;
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  animation: slideUp 0.3s ease both;
}

.meal-card:nth-child(3) { animation-delay: 0s; }
.meal-card:nth-child(4) { animation-delay: 0.05s; }
.meal-card:nth-child(5) { animation-delay: 0.1s; }
.meal-card:nth-child(6) { animation-delay: 0.15s; }

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.meal-type-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.meal-time {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.meal-items {
  padding-top: 10rpx;
}

.food-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.food-item:last-child {
  padding-bottom: 0;
}

.food-name {
  color: var(--color-text-primary);
}

.food-cal {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.meal-total {
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

/* ========== 目标进度卡片 ========== */
.goal-card {
  margin: 20rpx 30rpx 0;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--card-bg-warm), #FFE9D6);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.goal-card-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ========== 目标引导空状态 ========== */
.goal-guide {
  margin: 20rpx 30rpx 0;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--card-bg-warm), #FFE9D6);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.goal-guide-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  margin-right: 20rpx;
}

.goal-guide-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.goal-guide-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.goal-guide-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.goal-guide-btn {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--card-bg-white);
  background: var(--color-accent-orange);
  padding: 14rpx 26rpx;
  border-radius: var(--radius-sm);
  border: var(--border-width) solid var(--color-border);
  white-space: nowrap;
}

.goal-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.goal-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.goal-card-arrow {
  font-size: 40rpx;
  color: var(--color-accent-orange);
  line-height: 1;
}

.main-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.goal-remaining-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent-orange);
  white-space: nowrap;
  flex-shrink: 0;
}

.goal-remaining-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-accent-orange);
}

.bmi-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
  flex-shrink: 0;
}

.bmi-badge-normal {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.bmi-badge-under {
  background-color: #FFF8E1;
  color: #F57C00;
}

.bmi-badge-over {
  background-color: #FFEBEE;
  color: #C62828;
}

.goal-bar {
  height: 24rpx;
  background: var(--card-bg-light);
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.goal-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent-yellow), var(--color-accent-orange));
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.pl-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #555555;
  margin-right: 6rpx;
}

.pl-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #333333;
}

.goal-estimate {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: rgba(255, 107, 53, 0.12);
  border-radius: var(--radius-sm);
  padding: 10rpx 16rpx;
  text-align: center;
}

.goal-achieved {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 4rpx;
}

.goal-achieved-emoji {
  font-size: 64rpx;
  display: block;
}

.goal-achieved-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-accent-green);
  display: block;
  margin-top: 8rpx;
}

.goal-achieved-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 8rpx;
}

/* ===== Lose：单行微型断食状态条 ===== */
.fasting-strip-bar {
  margin: 20rpx 30rpx 0;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F0F7EA;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.fasting-strip-bar:active {
  transform: scale(0.99);
  opacity: 0.9;
}

.strip-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
}

.strip-icon {
  font-size: 28rpx;
  line-height: 1;
}

.strip-status {
  font-weight: 700;
  color: var(--color-accent-green);
}

.strip-dot {
  color: var(--color-text-light);
}

.strip-desc {
  color: var(--color-text-secondary);
}

.strip-arrow {
  font-size: 26rpx;
  color: var(--color-text-light);
  margin-left: 12rpx;
}

