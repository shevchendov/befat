.page-container {
  padding-bottom: 60rpx;
}

/* ========== 顶部品牌区 ========== */
.hero-banner {
  background: var(--color-primary);
  margin: 0;
  padding: 60rpx 40rpx 50rpx;
  position: relative;
  overflow: hidden;
}

.hero-banner::after {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.hero-banner::before {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.hero-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  position: relative;
  z-index: 1;
}

.hero-greeting {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 12rpx;
  line-height: 1.4;
  position: relative;
  z-index: 1;
}

.hero-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  position: relative;
  z-index: 1;
  animation: pop 0.5s ease;
}

/* ========== 进度环 ========== */
.progress-rings {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: -40rpx 0 20rpx;
  position: relative;
  z-index: 2;
}

.ring-wrapper {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  background: var(--card-bg-white);
  border: var(--border-width) solid var(--color-border);
  border-radius: 50%;
  box-shadow: var(--shadow-card);
  padding: 12rpx;
}

.ring-canvas {
  width: 236rpx;
  height: 236rpx;
}

.ring-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 200rpx;
}

.ring-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}

.ring-unit {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.ring-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  font-weight: 600;
}

/* ========== 快捷操作（贴纸按钮） ========== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 30rpx 10rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-icon {
  width: 110rpx;
  height: 110rpx;
  background: var(--card-bg-white);
  border: var(--border-width) solid var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s;
}

.action-btn:active .action-icon {
  transform: scale(0.9);
}

.action-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ========== 餐食列表标题 ========== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 30rpx 30rpx 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-light);
}

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 60rpx 30rpx;
  margin: 10rpx 30rpx;
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  background: var(--card-bg-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-light);
  display: block;
}

/* ========== 餐食卡片 ========== */
.meal-card {
  margin: 12rpx 30rpx;
  padding: 24rpx 28rpx;
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  animation: slideUp 0.3s ease both;
}

.meal-card:nth-child(3) { animation-delay: 0s; }
.meal-card:nth-child(4) { animation-delay: 0.05s; }
.meal-card:nth-child(5) { animation-delay: 0.1s; }
.meal-card:nth-child(6) { animation-delay: 0.15s; }

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.meal-type-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.meal-time {
  font-size: 24rpx;
  color: var(--color-text-light);
}

.meal-items {
  padding-top: 10rpx;
}

.food-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.food-item:last-child {
  padding-bottom: 0;
}

.food-name {
  color: var(--color-text-primary);
}

.food-cal {
  color: var(--color-text-secondary);
  font-weight: 500;
}

.meal-total {
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

/* ========== 目标进度卡片 ========== */
.goal-card {
  margin: 20rpx 30rpx 0;
  padding: 28rpx;
  background: linear-gradient(135deg, var(--card-bg-warm), #FFE9D6);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.goal-card-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.goal-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.goal-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.goal-card-arrow {
  font-size: 40rpx;
  color: var(--color-accent-orange);
  line-height: 1;
}

.goal-remaining {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.goal-remaining-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.goal-remaining-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-accent-orange);
}

.goal-bar {
  height: 24rpx;
  background: var(--card-bg-light);
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.goal-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent-yellow), var(--color-accent-orange));
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.goal-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-bottom: 12rpx;
}

.goal-estimate {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: rgba(255, 107, 53, 0.12);
  border-radius: var(--radius-sm);
  padding: 10rpx 16rpx;
  text-align: center;
}

.goal-achieved {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 4rpx;
}

.goal-achieved-emoji {
  font-size: 64rpx;
  display: block;
}

.goal-achieved-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-accent-green);
  display: block;
  margin-top: 8rpx;
}

.goal-achieved-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 8rpx;
}

