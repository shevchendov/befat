<view class="page-container">
  <view class="hero-banner">
    <view class="hero-profile-btn" bindtap="goToProfile" hover-class="hero-profile-btn-hover">👤 我的</view>
    <text class="hero-date">{{dateText}}</text>
    <text class="hero-greeting">{{greeting}}</text>
    <view class="hero-badge" wx:if="{{isTodayAchieved}}">🎯 今日目标达成！</view>
    <view class="hero-badge hero-badge-sprint" wx:else>🎯 今日目标冲刺中</view>
  </view>

  <!-- Gain：热量+蛋白双环（原样，逐字节不动） -->
  <view class="progress-rings" wx:if="{{goalType !== 'lose'}}">
    <view class="ring-wrapper">
      <canvas class="ring-canvas" type="2d" id="calorieCanvas"></canvas>
      <view class="ring-center">
        <view class="ring-value-row">
          <text class="ring-value">{{dailySummary.total_calorie}}</text>
          <text class="ring-unit">/ {{targets.calorie}}</text>
        </view>
        <text class="ring-title">🔥 热量</text>
      </view>
    </view>
    <view class="ring-wrapper">
      <canvas class="ring-canvas" type="2d" id="proteinCanvas"></canvas>
      <view class="ring-center">
        <view class="ring-value-row">
          <text class="ring-value">{{dailySummary.total_protein_g}}</text>
          <text class="ring-unit">/ {{targets.protein}}g</text>
        </view>
        <text class="ring-title">💪 蛋白质</text>
      </view>
    </view>
  </view>

  <!-- Lose：双圆环仪表盘（热量缺口环 + 微信步数环，与增重模式环结构统一） -->
  <view class="progress-rings" wx:elif="{{goalType === 'lose'}}">
    <view class="ring-wrapper">
      <canvas class="ring-canvas" type="2d" id="loseCalorieCanvas"></canvas>
      <view class="ring-center">
        <view class="ring-value-row">
          <text class="ring-value">{{dailySummary.total_calorie}}</text>
          <text class="ring-unit">/ {{targets.calorie}}</text>
        </view>
        <text class="ring-title">🔥 热量缺口</text>
        <text class="ring-sub {{overLimit ? 'ring-sub-warn' : ''}}">{{remainingCalorie === null ? '' : (remainingCalorie >= 0 ? '还可吃 ' + remainingCalorie + ' kcal' : '已超标 ' + (-remainingCalorie) + ' kcal')}}</text>
      </view>
    </view>
    <view class="ring-wrapper" bindtap="goToSteps">
      <canvas class="ring-canvas" type="2d" id="loseStepsCanvas"></canvas>
      <view class="ring-center">
        <view class="ring-value-row">
          <text class="ring-value">{{werunSteps}}</text>
          <text class="ring-unit">/ {{loseStepsTarget}}</text>
        </view>
        <text class="ring-title">🚶 今日步数</text>
        <text class="ring-sub">≈ {{werunCalorie}} kcal</text>
      </view>
    </view>
  </view>

  <!-- Gain：4 快捷入口（原样） -->
  <view class="quick-actions" wx:if="{{goalType !== 'lose'}}">
    <view class="action-btn" bindtap="goToLogFood">
      <view class="action-icon action-icon-orange"><text>🍽️</text></view>
      <text class="action-label">记录一餐</text>
    </view>
    <view class="action-btn" bindtap="onTapYuefan">
      <view class="action-icon action-icon-green"><text>🍲</text></view>
      <text class="action-label">约饭吧</text>
    </view>
    <view class="action-btn" bindtap="goToDailyMenu">
      <view class="action-icon action-icon-coral"><text>📖</text></view>
      <text class="action-label">今日增重食谱</text>
    </view>
    <view class="action-btn" bindtap="goToStats">
      <view class="action-icon action-icon-orange"><text>📈</text></view>
      <text class="action-label">达标统计</text>
    </view>
  </view>

  <!-- Lose：4 快捷入口（减重专属） -->
  <view class="quick-actions" wx:else>
    <view class="action-btn" bindtap="goToLogFood">
      <view class="action-icon action-icon-orange"><text>📸</text></view>
      <text class="action-label">视觉吃记</text>
    </view>
    <view class="action-btn" bindtap="goToSteps">
      <view class="action-icon action-icon-green"><text>🚶</text></view>
      <text class="action-label">每日步数</text>
    </view>
    <view class="action-btn" bindtap="goToFasting">
      <view class="action-icon action-icon-coral"><text>⏱️</text></view>
      <text class="action-label">断食计时</text>
    </view>
    <view class="action-btn" bindtap="goToCoach">
      <view class="action-icon action-icon-orange"><text>🎯</text></view>
      <text class="action-label">减脂教练</text>
    </view>
  </view>

  <view class="goal-card" wx:if="{{goalProgress}}" bindtap="goToGoalDetail" hover-class="goal-card-hover">
    <view class="goal-card-header">
      <text class="goal-card-title">🎯 目标进度</text>
      <text class="goal-card-arrow">›</text>
    </view>

    <block wx:if="{{goalProgress.achieved}}">
      <view class="goal-achieved">
        <text class="goal-achieved-emoji">🎉</text>
        <text class="goal-achieved-title">目标达成！</text>
        <text class="goal-achieved-sub">当前 {{goalProgress.current_weight}} kg，稳住了就是胜利！</text>
      </view>
    </block>

    <block wx:else>
      <view class="main-status-row">
        <text class="goal-remaining-label">{{targetProgressText}}</text>
        <text class="bmi-badge bmi-badge-{{bmiLevel}}" wx:if="{{bmiValue}}">BMI {{bmiValue}} ({{bmiStatus}})</text>
      </view>
      <view class="goal-bar">
        <view class="goal-bar-fill" style="width: {{goalProgress.barWidth}};"></view>
      </view>
      <view class="progress-labels">
        <view class="progress-item">
          <text class="pl-label">初始</text>
          <text class="pl-value">{{goalProgress.initial_weight}} kg</text>
        </view>
        <view class="progress-item">
          <text class="pl-label">当前</text>
          <text class="pl-value">{{goalProgress.current_weight}} kg</text>
        </view>
        <view class="progress-item">
          <text class="pl-label">目标</text>
          <text class="pl-value">{{goalProgress.target_weight}} kg</text>
        </view>
      </view>
      <text wx:if="{{goalProgress.estimated_date && goalProgress.estimate_basis === 'measured'}}" class="goal-estimate">照这个节奏，预计 {{goalProgress.estimated_date}} 达成</text>
      <text wx:elif="{{goalProgress.estimated_date}}" class="goal-estimate">按你的计划，预计 {{goalProgress.estimated_date}} 达成</text>
    </block>
  </view>

  <view class="goal-guide" wx:elif="{{showGoalGuide}}" bindtap="goToOnboarding" hover-class="goal-card-hover">
    <view class="goal-guide-content">
      <text class="goal-guide-emoji">🎯</text>
      <text class="goal-guide-title">设定你的目标，开始追踪进度</text>
      <text class="goal-guide-sub">填好身高体重，系统帮你计算{{goalType === 'lose' ? '减重' : '增重'}}方案</text>
    </view>
    <text class="goal-guide-btn">去设定 ›</text>
  </view>

  <view class="section-header">
    <text class="section-title">🍱 今天吃咗啥</text>
    <text wx:if="{{meals.length > 0}}" class="section-count">{{dailySummary.total_calorie}} / {{targets.calorie}} kcal</text>
  </view>

  <view wx:if="{{meals.length === 0}}" class="empty-state">
    <view class="empty-illustration">
      <text class="empty-emoji">🍽️</text>
    </view>
    <text class="empty-title">今天嘴巴还没开工呢！</text>
    <text class="empty-hint">快去上面点"记录一餐"，喂饱自己 💪</text>
  </view>

  <view wx:for="{{meals}}" wx:key="index" class="meal-card meal-{{item.mealType}}">
    <view class="meal-header">
      <view class="meal-type-tag">
        <text wx:if="{{item.mealType === 'breakfast'}}">🌅</text>
        <text wx:if="{{item.mealType === 'lunch'}}">☀️</text>
        <text wx:if="{{item.mealType === 'dinner'}}">🌙</text>
        <text wx:if="{{item.mealType === 'snack'}}">🍿</text>
        <text> {{item.mealLabel}}</text>
      </view>
      <text class="meal-time">{{item.time}}</text>
    </view>
    <view class="meal-items">
      <view wx:for="{{item.items}}" wx:for-item="food" wx:key="name" class="food-item">
        <text class="food-name">{{food.name}}</text>
        <text class="food-cal">{{food.calorie}}kcal</text>
      </view>
    </view>
    <view class="meal-total">
      <text>小计 {{item.total_calorie}} kcal · 蛋白质 {{item.total_protein_g}}g</text>
    </view>
  </view>

  <view class="celebrate-overlay" wx:if="{{showCelebration}}" catchtap="dismissCelebration">
    <view class="celebrate-modal">
      <text class="celebrate-emoji">🎉</text>
      <text class="celebrate-title">吃得不错嘛！</text>
      <text class="celebrate-sub">进度超过 80%，离做大只又近一步！<text>\n💪🔥</text></text>
      <button class="celebrate-btn" bindtap="dismissCelebration">继续干饭 🍖</button>
      <view class="confetti-container">
        <view class="confetti-piece" style="left:10%;top:-5%;background:#E8471F;animation-delay:0s"></view>
        <view class="confetti-piece" style="left:30%;top:-5%;background:#FF6B35;animation-delay:0.1s"></view>
        <view class="confetti-piece" style="left:50%;top:-5%;background:#639922;animation-delay:0.2s"></view>
        <view class="confetti-piece" style="left:70%;top:-5%;background:#FFD23F;animation-delay:0.15s"></view>
        <view class="confetti-piece" style="left:90%;top:-5%;background:#FF6B35;animation-delay:0.25s"></view>
        <view class="confetti-piece" style="left:20%;top:-5%;background:#639922;animation-delay:0.3s"></view>
        <view class="confetti-piece" style="left:60%;top:-5%;background:#E8471F;animation-delay:0.35s"></view>
        <view class="confetti-piece" style="left:80%;top:-5%;background:#FFD23F;animation-delay:0.05s"></view>
      </view>
    </view>
  </view>

  <view class="disclaimer">以上内容仅供参考，不构成医疗建议</view>
</view>
