.page-container {
  padding-bottom: 60rpx;
}

.meal-type-select {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666666;
  border: 2rpx solid #E5E5E5;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.type-option.selected {
  border: 4rpx solid var(--theme-primary, #E8471F);
  color: var(--theme-primary, #E8471F);
  background: var(--theme-light, #FFF5F2);
  font-weight: 600;
}

.food-input {
  width: 100%;
  min-height: 120rpx;
  background: #F8F4EC;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--border);
}

.input-wrap {
  position: relative;
  width: 100%;
}

.input-wrap .food-input {
  padding-right: 90rpx;
}

.camera-trigger {
  position: absolute;
  right: 16rpx;
  bottom: 14rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF5EB;
  border: 2rpx solid var(--border);
  border-radius: 50%;
}

.camera-trigger:active {
  background: #FFE6CC;
}

.camera-trigger.loading {
  opacity: 0.5;
  pointer-events: none;
}

.camera-icon {
  width: 32rpx;
  height: 32rpx;
}

.input-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.result-card {
  animation: fadeIn 0.3s ease;
}

.result-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
}

.result-hint {
  font-size: 24rpx;
  color: var(--text-light);
}

.parsed-item {
  background: #F8F4EC;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.item-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
  align-items: center;
}

.item-input {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  border: 2rpx solid var(--border);
}

.name-input {
  flex: 2;
}

.portion-input {
  flex: 1;
}

.item-nutrition {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.num-input {
  width: 100rpx;
  text-align: center;
}

.item-delete {
  text-align: right;
  font-size: 24rpx;
  color: var(--danger);
  margin-top: 8rpx;
}

.add-item {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--primary);
  border: 2rpx dashed var(--primary);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.result-total {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  margin: 20rpx 0;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.result-actions button {
  flex: 1;
}
