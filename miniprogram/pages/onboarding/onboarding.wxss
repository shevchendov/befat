.page-container {
  padding: 40rpx 30rpx;
}

.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.step {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E0D5C5;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.step.active {
  background: var(--color-primary);
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #E0D5C5;
  margin: 0 20rpx;
}

.step-line.active {
  background: var(--primary);
}

.step-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.margin-bottom {
  margin-bottom: 40rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.gender-select {
  display: flex;
  gap: 30rpx;
}

.gender-option {
  flex: 1;
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  border: 2rpx solid #E5E5E5;
  color: #666666;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.gender-option.selected {
  border: 4rpx solid var(--theme-primary);
  background: var(--theme-light);
  color: var(--theme-primary);
  font-weight: 600;
}

.goal-type-select {
  display: flex;
  gap: 30rpx;
}

.goal-type-option {
  flex: 1;
  padding: 34rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  text-align: center;
  border: 2rpx solid #E5E5E5;
  font-size: 28rpx;
  font-weight: 500;
  color: #666666;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.goal-type-option.selected {
  border: 4rpx solid var(--theme-primary);
  background: var(--theme-light);
  color: var(--theme-primary);
  font-weight: 600;
}

.goal-type-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 12rpx;
}

.gender-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.btn-next {
  margin-top: 60rpx;
}

.activity-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-option {
  padding: 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #E5E5E5;
  color: #666666;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.activity-option.selected {
  border: 4rpx solid var(--theme-primary);
  background: var(--theme-light);
  color: var(--theme-primary);
  font-weight: 600;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.activity-option.selected .activity-name {
  color: var(--theme-primary);
}

.activity-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}
