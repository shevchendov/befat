<view class="page-container">
  <view class="tag-filter">
    <scroll-view class="tag-scroll" scroll-x enable-flex>
      <view class="tag {{selectedTag === '' ? 'active' : ''}}" bindtap="filterByTag" data-tag="">全部</view>
      <view class="tag {{selectedTag === '__favorites__' ? 'active' : ''}}" bindtap="filterByTag" data-tag="__favorites__">❤ 我的收藏</view>
      <view class="tag {{selectedTag === tag ? 'active' : ''}}" bindtap="filterByTag" data-tag="{{tag}}" wx:for="{{tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
    </scroll-view>
  </view>

  <view class="recipe-grid">
    <view class="recipe-card" wx:for="{{filteredRecipes}}" wx:key="index" bindtap="goToDetail" data-id="{{item._id}}">
      <view class="recipe-info">
        <view class="recipe-header">
          <text class="recipe-title">{{item.title}}</text>
          <text class="fav-icon {{favoritedIds[item._id] ? 'fav-active' : ''}}" catchtap="toggleFav" data-id="{{item._id}}">{{favoritedIds[item._id] ? '♥' : '♡'}}</text>
        </view>
        <view class="recipe-stats">
          <text class="stat">{{item.calorie}} kcal</text>
          <text class="stat-divider">|</text>
          <text class="stat">蛋白质 {{item.protein_g}}g</text>
        </view>
        <view class="recipe-tags">
          <text class="mini-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{filteredRecipes.length === 0 && !loading}}" class="empty-state">
    <text>没有找到相关食谱</text>
  </view>

  <view class="disclaimer">食谱及营养信息仅供参考，不构成医疗建议</view>
</view>
