.page-container {
  padding-bottom: 60rpx;
}

.tag-filter {
  padding: 20rpx 30rpx 10rpx;
}

.tag-scroll {
  display: flex;
  white-space: nowrap;
}

.tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: var(--card-bg-light);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--border-divider);
}

.tag.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.recipe-grid {
  padding: 10rpx 30rpx;
}

.recipe-card {
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s;
}

.recipe-card:active {
  transform: scale(0.97);
}

.recipe-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.recipe-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.fav-icon {
  font-size: 108rpx;
  color: var(--text-light);
  padding: 12rpx 12rpx 12rpx 24rpx;
  transition: color 0.2s;
  line-height: 1;
}

.fav-icon.fav-active {
  color: var(--danger);
}

.recipe-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.stat {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.stat-divider {
  color: var(--border);
}

.recipe-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: var(--card-bg-light);
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.empty-state {
  text-align: center;
  padding: 80rpx 30rpx;
  color: var(--text-light);
  font-size: 30rpx;
}
