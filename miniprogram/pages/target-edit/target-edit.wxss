.target-edit-page {
  padding: 30rpx 30rpx 60rpx;
}

/* ========== 目标模式徽章 ========== */
.goal-type-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.goal-type-badge-gain {
  background: #FFF5EB;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.goal-type-badge-lose {
  background: #EAF7EF;
  color: #2ECC71;
  border: 2rpx solid #2ECC71;
}

/* ========== 模式切换 Tab ========== */
.mode-tabs {
  display: flex;
  background: var(--card-bg-light);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #666666;
  background: #FFFFFF;
  border: 2rpx solid #E5E5E5;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.mode-tab-active {
  background: var(--theme-light);
  color: var(--theme-primary);
  font-weight: 600;
  border: 4rpx solid var(--theme-primary);
  box-shadow: var(--shadow-card);
}

.mode-hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* ========== 表单卡片 ========== */
.form-card {
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 36rpx 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 14rpx;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-wrap .input-number {
  padding-right: 90rpx;
}

.input-unit {
  position: absolute;
  right: 28rpx;
  font-size: 28rpx;
  color: var(--color-text-light);
}

.profile-note {
  background: var(--card-bg-light);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.submit-btn {
  margin-top: 10rpx;
}

.loading-tip {
  text-align: center;
  color: var(--color-text-light);
  padding: 120rpx 0;
  font-size: 28rpx;
}
