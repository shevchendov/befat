<view class="page-container target-edit-page">
  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'recalc' ? 'mode-tab-active' : ''}}" bindtap="switchMode" data-mode="recalc">
      <text>重新计算</text>
    </view>
    <view class="mode-tab {{mode === 'manual' ? 'mode-tab-active' : ''}}" bindtap="switchMode" data-mode="manual">
      <text>手动微调</text>
    </view>
  </view>

  <view class="mode-hint" wx:if="{{mode === 'recalc'}}">
    <text>只需更新当前体重和目标体重，系统会按你的档案重新计算每日目标</text>
  </view>
  <view class="mode-hint" wx:else>
    <text>直接填入具体数值，跳过自动计算（请确保数值在合理范围内）</text>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <block wx:elif="{{mode === 'recalc'}}">
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">当前体重</text>
        <view class="input-wrap">
          <input class="input-number" type="digit" value="{{form.current_weight_kg}}" bindinput="onInput" data-field="current_weight_kg" placeholder="请输入当前体重" />
          <text class="input-unit">kg</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">目标体重</text>
        <view class="input-wrap">
          <input class="input-number" type="digit" value="{{form.target_weight_kg}}" bindinput="onInput" data-field="target_weight_kg" placeholder="请输入目标体重" />
          <text class="input-unit">kg</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">计划周期</text>
        <view class="input-wrap">
          <input class="input-number" type="number" value="{{form.target_weeks}}" bindinput="onInput" data-field="target_weeks" placeholder="预计多少周达成(1-104)" />
          <text class="input-unit">周</text>
        </view>
      </view>

      <view class="profile-note">
        <text>档案复用：{{profileText}}</text>
      </view>

      <button class="btn-primary submit-btn" disabled="{{submitting}}" bindtap="submitRecalc">
        {{submitting ? '提交中...' : '重新计算目标'}}
      </button>
    </view>
  </block>

  <block wx:else>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">每日热量目标</text>
        <view class="input-wrap">
          <input class="input-number" type="number" value="{{form.daily_calorie_target}}" bindinput="onInput" data-field="daily_calorie_target" placeholder="请输入每日热量" />
          <text class="input-unit">kcal</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">每日蛋白质目标</text>
        <view class="input-wrap">
          <input class="input-number" type="number" value="{{form.daily_protein_target_g}}" bindinput="onInput" data-field="daily_protein_target_g" placeholder="请输入蛋白质目标" />
          <text class="input-unit">g</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">目标体重</text>
        <view class="input-wrap">
          <input class="input-number" type="digit" value="{{form.target_weight_kg}}" bindinput="onInput" data-field="target_weight_kg" placeholder="请输入目标体重" />
          <text class="input-unit">kg</text>
        </view>
      </view>

      <button class="btn-primary submit-btn" disabled="{{submitting}}" bindtap="submitManual">
        {{submitting ? '提交中...' : '保存修改'}}
      </button>
    </view>
  </block>

  <view class="disclaimer">数值调整仅供自我管理参考，不构成医疗建议</view>
</view>
