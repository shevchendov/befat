.page-container {
  padding-bottom: 60rpx;
}

.summary-card {
  margin: 20rpx 30rpx 0;
  text-align: center;
}

.pill {
  display: inline-flex;
  align-items: center;
  background: var(--primary-bg);
  border: var(--border-width) solid var(--color-border);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
}

.pill-num {
  color: var(--primary);
  font-weight: 700;
  font-size: 32rpx;
}

.pill-unit {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.pill-sep {
  margin: 0 12rpx;
  color: var(--text-light);
}

.summary-date {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.poi-link {
  display: inline-block;
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 8rpx;
  padding: 4rpx 0;
}

.action-bar-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 30rpx 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 68rpx;
  padding: 0 36rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-bar-row .action-btn {
  flex: 1;
  height: 68rpx;
  padding: 0;
  font-size: 26rpx;
}

.action-bar-row .action-btn-icon {
  font-size: 26rpx;
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.action-btn-icon {
  font-size: 26rpx;
}

.action-btn.primary {
  background-color: #FF5722;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(255, 87, 34, 0.25);
}

.action-btn.secondary {
  background-color: #FFFFFF;
  border: 2rpx solid rgba(255, 87, 34, 0.3);
  color: #E8471F;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.action-btn.primary.refreshing {
  opacity: 0.7;
}

.meal-card {
  margin-top: 24rpx;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.meal-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #FF5722;
  background: var(--primary-bg);
  border: 2rpx solid rgba(255, 87, 34, 0.4);
  border-radius: 22rpx;
  padding: 6rpx 20rpx;
}

.fav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 107, 53, 0.08);
  transition: background 0.2s;
}

.fav-btn:active {
  transform: scale(0.92);
}

.fav-icon {
  width: 40rpx;
  height: 40rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml;base64,");
  transition: transform 0.15s;
}

.fav-btn.fav-on {
  background: rgba(255, 87, 34, 0.12);
}

.fav-btn.fav-on .fav-icon {
  background-image: url("data:image/svg+xml;base64,");
  transform: scale(1.1);
}

.meal-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.meal-nutrition {
  font-size: 26rpx;
  color: var(--text-light);
  margin-bottom: 16rpx;
}

.nutrition-num {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
}

.nutrition-unit {
  font-size: 26rpx;
  color: var(--text-light);
}

.detail-toggle {
  margin: 16rpx 0 4rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border: 2rpx dashed var(--primary);
  border-radius: 999rpx;
  padding: 10rpx 0;
}

.detail-toggle.detail-loading {
  opacity: 0.5;
  color: var(--text-light);
  border-color: var(--border);
}

.list-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-light);
  margin: 14rpx 0 6rpx;
}

.meal-ingredient {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.7;
}

.meal-step {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-secondary);
  line-height: 1.7;
}

.from-fallback {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 20rpx;
}

.disclaimer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 12rpx;
}

.skeleton {
  margin: 40rpx 30rpx 0;
}

.sk-pill {
  height: 56rpx;
  width: 60%;
  margin: 8rpx auto 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F0E7DC 25%, #FBF4EA 50%, #F0E7DC 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite;
}

.sk-card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.sk-line {
  height: 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #F0E7DC 25%, #FBF4EA 50%, #F0E7DC 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease infinite;
  margin-bottom: 16rpx;
}

.sk-line.w70 {
  width: 70%;
}

.sk-line.w40 {
  width: 40%;
}

.sk-cook {
  text-align: center;
  margin-top: 40rpx;
}

.sk-emoji {
  font-size: 72rpx;
  display: inline-block;
  animation: bounce 1.2s ease-in-out infinite;
}

.sk-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
}

@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-16rpx);
  }
}

.fav-drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  opacity: 0;
  transition: opacity 0.28s ease;
}

.fav-drawer-mask.mask-show {
  opacity: 1;
}

.fav-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 75vh;
  z-index: 1000;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.28s ease;
}

.fav-drawer.drawer-show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 12rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.drawer-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-secondary);
}

.drawer-tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 30rpx 20rpx;
}

.drawer-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  padding: 10rpx 0;
}

.drawer-tab.tab-active {
  background: var(--primary);
  color: #FFFFFF;
}

.drawer-body {
  flex: 1;
  height: 0;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.fav-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.fav-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fav-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.fav-card-nutrition {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.drawer-detail-loading {
  margin: 12rpx 0 4rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
}

.drawer-empty {
  text-align: center;
  padding-top: 100rpx;
}

.drawer-loading {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-light);
  padding-top: 100rpx;
}

.empty-emoji {
  font-size: 72rpx;
  display: block;
}

.empty-main {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-top: 20rpx;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.poi-loading {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.poi-error {
  text-align: center;
  padding: 100rpx 30rpx;
}

.poi-error-emoji {
  display: block;
  font-size: 72rpx;
}

.poi-error-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin: 20rpx 0 32rpx;
}

.poi-retry {
  display: inline-flex;
}

.poi-list {
  padding: 36rpx 24rpx 60rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.poi-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background: var(--card-bg);
  border-radius: 24rpx;
  border: 4rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.poi-info {
  flex: 1;
  margin-right: 24rpx;
}

.poi-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.poi-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}

.poi-category {
  color: var(--primary);
}

.poi-distance {
  color: var(--text-secondary);
}

.poi-address {
  font-size: 24rpx;
  color: var(--text-light);
  line-height: 1.6;
}

.poi-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.poi-action {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  text-align: center;
}

.poi-more {
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
  padding: 20rpx 0;
}