<view class="page-container">
  <block wx:if="{{currentView === 'recipe'}}">
    <view class="skeleton" wx:if="{{isGenerating}}">
      <view class="sk-pill"></view>
      <view class="sk-card">
        <view class="sk-line w70"></view>
        <view class="sk-line w40"></view>
      </view>
      <view class="sk-card">
        <view class="sk-line w70"></view>
        <view class="sk-line w40"></view>
      </view>
      <view class="sk-cook">
        <view class="sk-emoji">🍳</view>
        <view class="sk-tip">营养师正在配餐，稍等片刻… 🥗</view>
      </view>
    </view>

    <block wx:if="{{!isGenerating}}">
      <view class="summary-card">
        <view class="pill">
          <text>约 </text>
          <text class="pill-num">{{total_calorie}}</text>
          <text class="pill-unit"> kcal</text>
          <text class="pill-sep">·</text>
          <text>蛋白质约 </text>
          <text class="pill-num">{{total_protein_g}}</text>
          <text class="pill-unit">g</text>
        </view>
        <view class="summary-date">{{date}}</view>
        <view class="poi-link" bindtap="switchView" data-view="poi">📍 附近美食 ➔</view>
      </view>

      <view class="action-bar-row">
        <view class="action-btn primary {{refreshing ? 'refreshing' : ''}}" bindtap="refreshMenu">
          <text class="action-btn-icon">🔄</text>
          <text>{{refreshing ? '生成中…' : '换一换'}}</text>
        </view>
        <view class="action-btn secondary" bindtap="openFavoriteDrawer">
          <text class="action-btn-icon">🙋</text>
          <text>我的菜库</text>
        </view>
      </view>

      <view class="card meal-card" wx:for="{{meals}}" wx:for-item="meal" wx:for-index="idx" wx:key="meal_type">
        <view class="meal-header">
          <view class="meal-tag">{{meal.mealLabel}}</view>
          <view class="fav-btn {{meal.favorited ? 'fav-on' : ''}}" catchtap="toggleFav" data-index="{{idx}}">
            <view class="fav-icon"></view>
          </view>
        </view>
        <view class="meal-title">{{meal.title}}</view>
        <view class="meal-nutrition">
          <text>约 </text>
          <text class="nutrition-num">{{meal.calorie}}</text>
          <text class="nutrition-unit"> kcal</text>
          <text> · 蛋白质约 </text>
          <text class="nutrition-num">{{meal.protein_g}}</text>
          <text class="nutrition-unit">g</text>
        </view>

        <view class="detail-toggle {{meal.detailLoading ? 'detail-loading' : ''}}" bindtap="toggleDetail" data-index="{{idx}}">
          <text>{{meal.detailLoading ? '生成中…' : (meal.expanded ? '收起 ▲' : '查看食材与步骤 ▼')}}</text>
        </view>

        <block wx:if="{{meal.expanded}}">
          <view class="list-label">食材</view>
          <view class="meal-ingredient" wx:for="{{meal.ingredients}}" wx:for-item="ing" wx:key="*this">{{ing}}</view>

          <view class="list-label">步骤</view>
          <view class="meal-step" wx:for="{{meal.steps}}" wx:for-item="step" wx:key="*this">{{index + 1}}. {{step}}</view>
        </block>
      </view>

      <view class="from-fallback" wx:if="{{fromFallback}}">今日食谱暂不可用，已为你准备备用食谱</view>
      <view class="disclaimer">💡 营养数据基于通用食材均值估算，仅供备餐灵感参考，不构成医疗建议。</view>
    </block>
  </block>

  <block wx:if="{{currentView === 'poi'}}">
    <view class="poi-back" bindtap="switchView" data-view="recipe">← 返回食谱</view>

    <view wx:if="{{poiLoading}}" class="poi-loading">📍 定位中，正在查找周边美食…</view>

    <view wx:if="{{poiError && !poiLoading}}" class="poi-error">
      <text class="poi-error-emoji">🍜</text>
      <text class="poi-error-text">{{poiMsg}}</text>
      <view class="action-btn secondary poi-retry" bindtap="retryPoi">重新定位</view>
    </view>

    <block wx:if="{{!poiError && !poiLoading}}">
      <view class="poi-card" wx:for="{{poiList}}" wx:for-item="poi" wx:for-index="pi" wx:key="id">
        <view class="poi-info">
          <view class="poi-title">{{poi.title}}</view>
          <view class="poi-meta">
            <text class="poi-category">{{poi.category}}</text>
            <text class="poi-distance">· {{poi.distance_text}}</text>
          </view>
          <view class="poi-address">{{poi.address}}</view>
        </view>
        <view class="poi-actions">
          <view class="poi-action" catchtap="openPoi" data-index="{{pi}}">🧭 导航</view>
          <view class="poi-action" wx:if="{{poi.tel}}" catchtap="callPoi" data-index="{{pi}}">📞 电话</view>
        </view>
      </view>

      <view wx:if="{{poiList.length > 0 && poiList.length < poiTotal}}" class="poi-more" bindtap="loadMorePoi">{{poiLoadMore ? '加载中…' : '加载更多'}}</view>
    </block>
  </block>

  <view class="fav-drawer-mask {{drawerVisible ? 'mask-show' : ''}}" wx:if="{{drawerVisible}}" bindtap="closeFavoriteDrawer"></view>

  <view class="fav-drawer {{drawerVisible ? 'drawer-show' : ''}}">
    <view class="drawer-header">
      <text class="drawer-title">🥘 我的菜库</text>
      <view class="drawer-close" catchtap="closeFavoriteDrawer">✕</view>
    </view>

    <view class="drawer-tabs">
      <view class="drawer-tab {{favTab === 'all' ? 'tab-active' : ''}}" catchtap="switchFavTab" data-tab="all">全部</view>
      <view class="drawer-tab {{favTab === 'breakfast' ? 'tab-active' : ''}}" catchtap="switchFavTab" data-tab="breakfast">早餐</view>
      <view class="drawer-tab {{favTab === 'lunchdinner' ? 'tab-active' : ''}}" catchtap="switchFavTab" data-tab="lunchdinner">正餐</view>
      <view class="drawer-tab {{favTab === 'snack' ? 'tab-active' : ''}}" catchtap="switchFavTab" data-tab="snack">加餐</view>
    </view>

    <scroll-view class="drawer-body" scroll-y>
      <view wx:if="{{favLoading && favList.length === 0}}" class="drawer-loading">加载中…</view>

      <view wx:if="{{favList.length === 0 && !favLoading}}" class="drawer-empty">
        <text class="empty-emoji">🥗</text>
        <text class="empty-main">还没有收藏的菜</text>
        <text class="empty-sub">去今日食谱里点 ❤️ 收藏一道喜欢的菜吧</text>
      </view>

      <view class="fav-card" wx:for="{{favList}}" wx:for-item="fav" wx:for-index="fi" wx:key="title">
        <view class="fav-card-header">
          <view class="meal-tag">{{fav.mealLabel}}</view>
          <view class="fav-btn fav-on" catchtap="removeFavFromDrawer" data-index="{{fi}}">
            <view class="fav-icon"></view>
          </view>
        </view>
        <view class="fav-card-title">{{fav.title}}</view>
        <view class="fav-card-nutrition">约 {{fav.calorie}} kcal · 蛋白质约 {{fav.protein_g}}g</view>
        <view class="detail-toggle {{fav.loading ? 'detail-loading' : ''}}" bindtap="toggleDrawerDetail" data-index="{{fi}}">
          <text>{{fav.loading ? '生成中…' : (fav.expanded ? '收起 ▲' : '查看食材与步骤 ▼')}}</text>
        </view>
        <view wx:if="{{fav.loading}}" class="drawer-detail-loading">详情生成中…</view>
        <block wx:if="{{fav.expanded && !fav.loading}}">
          <view class="list-label">食材</view>
          <view class="meal-ingredient" wx:for="{{fav.ingredients}}" wx:for-item="ing" wx:key="*this">{{ing}}</view>
          <view class="list-label">步骤</view>
          <view class="meal-step" wx:for="{{fav.steps}}" wx:for-item="step" wx:key="*this">{{index + 1}}. {{step}}</view>
        </block>
      </view>
    </scroll-view>
  </view>
</view>