<view class="page-container">
  <view class="card skeleton" wx:if="{{loading}}">
    <view class="sk-line sk-pill"></view>
    <view class="sk-line" style="width:70%"></view>
    <view class="sk-line" style="width:40%"></view>
    <view class="sk-tip">食谱生成中，请稍候…</view>
  </view>

  <block wx:if="{{!loading}}">
    <view class="summary-card">
      <view class="pill">
        <text class="pill-num">{{total_calorie}}</text>
        <text class="pill-unit"> kcal</text>
        <text class="pill-sep">·</text>
        <text>蛋白质 </text>
        <text class="pill-num">{{total_protein_g}}</text>
        <text class="pill-unit">g</text>
      </view>
      <view class="summary-date">{{date}}</view>
    </view>

    <view class="card meal-card" wx:for="{{meals}}" wx:for-item="meal" wx:for-index="idx" wx:key="meal_type">
      <view class="meal-header">
        <view class="meal-tag">{{meal.mealLabel}}</view>
        <view class="fav-btn {{meal.favorited ? 'fav-on' : ''}}" catchtap="toggleFav" data-index="{{idx}}">
          <text>{{meal.favorited ? '♥' : '♡'}}</text>
        </view>
      </view>
      <view class="meal-title">{{meal.title}}</view>
      <view class="meal-nutrition">{{meal.calorie}} kcal · 蛋白质 {{meal.protein_g}}g</view>

      <view class="list-label">食材</view>
      <view class="meal-ingredient" wx:for="{{meal.ingredients}}" wx:for-item="ing" wx:key="*this">{{ing}}</view>

      <view class="list-label">步骤</view>
      <view class="meal-step" wx:for="{{meal.steps}}" wx:for-item="step" wx:key="*this">{{index + 1}}. {{step}}</view>
    </view>

    <view class="from-fallback" wx:if="{{fromFallback}}">今日食谱暂不可用，已为你准备备用食谱</view>
    <view class="disclaimer">以上食谱为自动生成，仅供参考，不构成医疗建议</view>
  </block>
</view>