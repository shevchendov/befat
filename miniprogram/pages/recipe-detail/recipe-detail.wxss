.page-container {
  padding-bottom: 60rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 24rpx;
  color: var(--text-primary);
}

.detail-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.detail-stat {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-tag {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF5EB;
  font-size: 24rpx;
  color: var(--primary-light);
}

.section-title-inner {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
  color: var(--text-primary);
}

.ingredient-item {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border);
}

.ingredient-item:last-child {
  border-bottom: none;
}

.ingredient-bullet {
  color: var(--primary);
}

.step-item {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.step-item:last-child {
  border-bottom: none;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}
