<view class="page-container">
  <view class="card" wx:if="{{recipe}}">
    <view class="detail-header">
      <text class="detail-title">{{recipe.title}}</text>
      <text class="detail-fav {{favorited ? 'fav-active' : ''}}" bindtap="toggleFav">{{favorited ? '♥' : '♡'}}</text>
    </view>
    <view class="detail-stats">
      <view class="detail-stat">
        <text class="stat-num">{{recipe.calorie}}</text>
        <text class="stat-label">千卡</text>
      </view>
      <view class="detail-stat">
        <text class="stat-num">{{recipe.protein_g}}g</text>
        <text class="stat-label">蛋白质</text>
      </view>
    </view>

    <view class="detail-tags">
      <text class="mini-tag" wx:for="{{recipe.tags}}" wx:key="this">{{item}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe}}">
    <text class="section-title-inner">食材清单</text>
    <view class="ingredient-item" wx:for="{{recipe.ingredients}}" wx:key="index">
      <text class="ingredient-bullet">•</text>
      <text>{{item.name}}{{item.amount ? ' ' + item.amount + (item.unit || '') : ''}}{{item.note ? '（' + item.note + '）' : ''}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{recipe}}">
    <text class="section-title-inner">做法步骤</text>
    <view class="step-item" wx:for="{{recipe.steps}}" wx:key="index">
      <text class="step-num">{{index + 1}}</text>
      <text class="step-text">{{item}}</text>
    </view>
  </view>

  <view class="disclaimer">食谱及营养信息仅供参考，不构成医疗建议</view>
</view>
