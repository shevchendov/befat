.stats-page {
  padding: 30rpx;
}

.loading {
  text-align: center;
  color: var(--color-text-light);
  padding: 120rpx 0;
  font-size: 28rpx;
}

.error-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.error-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 30rpx;
}

.retry-btn {
  background: var(--color-accent-orange);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  padding: 16rpx 40rpx;
}

.summary-card {
  background: linear-gradient(135deg, var(--card-bg-warm), #FFE9D6);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 30rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.summary-note {
  font-size: 22rpx;
  color: var(--color-text-light);
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.summary-item {
  flex: 1 1 40%;
  background: var(--card-bg-light);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.summary-value {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--color-accent-orange);
  margin-top: 8rpx;
}

.summary-sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 8rpx;
}

.stats-section {
  margin-top: 30rpx;
}

.stats-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.chart-card {
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.chart-legend {
  display: flex;
  gap: 30rpx;
  margin-bottom: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.dot-ok {
  background: #43A047;
}

.dot-fail {
  background: #FF6B35;
}

.dot-none {
  background: #C9C2B8;
}

.trend-canvas {
  display: block;
  width: 100%;
  height: 420rpx;
}

.empty-state {
  text-align: center;
  color: var(--color-text-light);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.week-card {
  background: var(--card-bg-warm);
  border: var(--border-width) solid var(--color-border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.week-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}

.week-label {
  width: 130rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.week-bar {
  flex: 1;
  height: 24rpx;
  background: var(--card-bg-light);
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.week-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent-yellow), var(--color-accent-orange));
  border-radius: 12rpx;
}

.week-bar-warn {
  background: #FF4D4F;
}

.week-rate {
  width: 90rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-accent-orange);
  flex-shrink: 0;
}

.week-delta {
  width: 140rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}
