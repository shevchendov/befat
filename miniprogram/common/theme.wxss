/* ========================================
   统一视觉规范 - design tokens & mixins
   参考：goal-detail 页面确认视觉风格
   ======================================== */

page {
  /* ----- 主色系 ----- */
  --color-primary: #E8471F;
  --color-primary-dark: #D43D1A;
  --color-primary-bg: #FFF8E7;

  /* ----- 选择卡片选中态主题（随目标模式动态覆盖） ----- */
  /* 默认 = gain 增重橙；.goal-lose 下覆盖为减重绿 */
  --theme-primary: #E8471F;
  --theme-light: #FFF5F2;
  --theme-primary-lose: #639922;
  --theme-light-lose: #F0F7EA;

  /* ----- 卡片/背景色 ----- */
  --card-bg-warm: #FFF8F0;
  --card-bg-light: #FFF3E0;
  --card-bg-white: #FFF;

  /* ----- 强调色 ----- */
  --color-accent-yellow: #FFD23F;
  --color-accent-orange: #FF6B35;
  --color-accent-green: #639922;

  /* ----- 中性色 ----- */
  --color-text-primary: #1A1006;
  --color-text-secondary: #666;
  --color-text-light: #999;
  --color-border: #1A1006;

  /* ----- 描边 & 圆角 ----- */
  --border-width: 4rpx;
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 40rpx;

  /* ----- 阴影 ----- */
  --shadow-card: 0 4rpx 20rpx rgba(0,0,0,0.08);
  --shadow-strong: 0 8rpx 32rpx rgba(0,0,0,0.15);

  /* ----- 倾斜角度（装饰用，非高强度页面不加） ----- */
  --tilt-subtle: -2deg;
}

/* 减重模式：覆盖选择卡片选中态主题为绿色系 */
.goal-lose {
  --theme-primary: var(--theme-primary-lose);
  --theme-light: var(--theme-light-lose);
}
