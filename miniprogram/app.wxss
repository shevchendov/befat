page {
  --primary: #FF8C42;
  --primary-light: #FFB07A;
  --primary-bg: #FFF8E7;
  --success: #4CAF50;
  --warning: #FF9800;
  --danger: #F44336;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border: #F0E6D6;
  --card-bg: #FFFFFF;
  --bg: #FFF8E7;

  background-color: var(--bg);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
}

view, scroll-view, swiper, text, image, button, input, textarea {
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--primary);
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--primary);
  width: 100%;
}

.btn-secondary:active {
  opacity: 0.7;
}

.input-field {
  background: #F8F4EC;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-field:focus {
  border-color: var(--primary);
}

.input-number {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  background: #F8F4EC;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-number:focus {
  border-color: var(--primary);
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.5;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
