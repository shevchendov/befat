@import 'common/theme.wxss';

page {
  --primary: var(--color-primary);
  --primary-bg: var(--color-primary-bg);
  --primary-light: var(--card-bg-light);
  --coral: #FF6B6B;
  --coral-light: #FF9B9B;
  --success: #2ECC71;
  --success-light: #A8E6CF;
  --warning: #FFB347;
  --danger: #FF6B6B;
  --text-primary: var(--color-text-primary);
  --text-secondary: var(--color-text-secondary);
  --text-light: var(--color-text-light);
  --border: var(--color-border);
  --card-bg: var(--card-bg-white);
  --bg: var(--color-primary-bg);
  --primary-gradient: linear-gradient(135deg, var(--color-primary), #FF6B35);

  background-color: var(--bg);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
}

view, scroll-view, swiper, text, image, button, input, textarea {
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin: 16rpx 30rpx;
  box-shadow: var(--shadow-card);
  border: var(--border-width) solid var(--color-border);
}

.card-bare {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin: 16rpx 30rpx;
  box-shadow: var(--shadow-card);
}

.card-gradient {
  background: var(--card-bg-light);
  border-radius: var(--radius-md);
  padding: 30rpx;
  margin: 16rpx 30rpx;
  box-shadow: var(--shadow-card);
  border: var(--border-width) solid var(--color-border);
}

.card-coral {
  background: var(--card-bg-warm);
}

.card-green {
  background: var(--card-bg-warm);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--card-bg-white);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  border: var(--border-width) solid var(--color-border);
  width: 100%;
  transition: transform 0.15s;
}

.btn-primary:active {
  transform: scale(0.96);
}

.btn-primary[disabled] {
  opacity: 0.5;
  border-color: var(--color-text-light);
}

.btn-secondary {
  background: var(--card-bg-white);
  color: var(--color-text-primary);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: var(--border-width) solid var(--color-border);
  width: 100%;
  transition: transform 0.15s;
}

.btn-secondary:active {
  transform: scale(0.96);
}

.input-field {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-field:focus {
  border-color: var(--primary);
}

.input-number {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  background: #FFF8F0;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-number:focus {
  border-color: var(--primary);
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.5;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.celebrate-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.celebrate-modal {
  background: var(--card-bg-white);
  border-radius: var(--radius-md);
  border: var(--border-width) solid var(--color-border);
  padding: 60rpx 50rpx 50rpx;
  width: 580rpx;
  text-align: center;
  animation: bounceIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  position: relative;
  overflow: hidden;
}

.celebrate-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: pop 0.5s ease 0.2s both;
}

.celebrate-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.celebrate-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.celebrate-btn {
  background: var(--color-primary);
  color: var(--card-bg-white);
  border-radius: var(--radius-lg);
  padding: 22rpx 60rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: var(--border-width) solid var(--color-border);
  transition: transform 0.15s;
}

.celebrate-btn:active {
  transform: scale(0.96);
}

.confetti-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  animation: confettiFall 1.5s ease-out forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes bounceIn {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.08); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes pop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(400rpx) rotate(720deg); opacity: 0; }
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
