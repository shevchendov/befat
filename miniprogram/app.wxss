page {
  --primary: #FF7A2F;
  --primary-light: #FF9B5E;
  --primary-bg: #FFF0E0;
  --primary-gradient: linear-gradient(135deg, #FF7A2F, #FFB07A);
  --coral: #FF6B6B;
  --coral-light: #FF9B9B;
  --success: #2ECC71;
  --success-light: #A8E6CF;
  --warning: #FFB347;
  --danger: #FF6B6B;
  --text-primary: #2D2D2D;
  --text-secondary: #7A7A7A;
  --text-light: #B0B0B0;
  --border: #F5E6D0;
  --card-bg: #FFFFFF;
  --bg: #FFF5EB;
  --card-gradient-1: linear-gradient(135deg, #FFF5EB, #FFE8D0);
  --card-gradient-2: linear-gradient(135deg, #FFF0F0, #FFE0E0);
  --card-gradient-3: linear-gradient(135deg, #F0FFF4, #D8F5E0);

  background-color: var(--bg);
  color: var(--text-primary);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  box-sizing: border-box;
}

view, scroll-view, swiper, text, image, button, input, textarea {
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 16rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 122, 47, 0.08);
}

.card-gradient {
  background: var(--card-gradient-1);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 16rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 122, 47, 0.1);
}

.card-coral {
  background: var(--card-gradient-2);
}

.card-green {
  background: var(--card-gradient-3);
}

.btn-primary {
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 47, 0.3);
  transition: transform 0.15s;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--primary);
  border-radius: 50rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border: 2rpx solid var(--primary);
  width: 100%;
}

.btn-secondary:active {
  opacity: 0.7;
}

.input-field {
  background: #FFF8F0;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-field:focus {
  border-color: var(--primary);
}

.input-number {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  background: #FFF8F0;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  width: 100%;
}

.input-number:focus {
  border-color: var(--primary);
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.disclaimer {
  font-size: 22rpx;
  color: var(--text-light);
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.5;
}

.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.celebrate-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.celebrate-modal {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 50rpx 50rpx;
  width: 580rpx;
  text-align: center;
  animation: bounceIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  position: relative;
  overflow: hidden;
}

.celebrate-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  animation: pop 0.5s ease 0.2s both;
}

.celebrate-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.celebrate-sub {
  font-size: 28rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.celebrate-btn {
  background: var(--primary-gradient);
  color: #fff;
  border-radius: 50rpx;
  padding: 22rpx 60rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 47, 0.3);
}

.celebrate-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.confetti-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  animation: confettiFall 1.5s ease-out forwards;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes bounceIn {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.08); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes pop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(400rpx) rotate(720deg); opacity: 0; }
}

@keyframes slideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
