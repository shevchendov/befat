#!/bin/sh
# post-commit hook — auto-append last commit to CHANGELOG.md (with sensitive info masking & deploy reminders)
HASH=$(git log -1 --format="%h")
DATE=$(git log -1 --format="%ad" --date=short)
SUBJECT=$(git log -1 --format="%s")
BODY=$(git log -1 --format="%b")
FILES=$(git diff-tree --no-commit-id -r --name-only HEAD | sed 's/^/- `/' | sed 's/$/`/')
CHANGELOG="CHANGELOG.md"

# Mask sensitive patterns in commit message
MASKED=0
mask_value() {
  MASKED=1
  printf '%s' "$1" | sed -E \
    -e 's/(sk-[a-zA-Z0-9]{10,})/sk-***/g' \
    -e 's/(-----BEGIN[ A-Z]*KEY-----)[^#]*/\1`***`/g' \
    -e 's/((api[_-]?key|apikey|password|passwd|secret|token|auth[_-]?token|private[_-]?key|access[_-]?key|session[_-]?key)[[:space:]]*[:=][[:space:]]*)[\x27"]?[a-zA-Z0-9_\-\.\/+]{8,}[\x27"]?/\1***/gi' \
    -e 's/((mongodb|postgresql|mysql|redis):\/\/)[^@\s]+@/\1***@/g' \
    -e 's/((http|https):\/\/)[^:]+:[^@]+@/\1***:***@/g'
}

SUBJECT=$(mask_value "$SUBJECT")
BODY=$(mask_value "$BODY")
FILES=$(mask_value "$FILES")

# Extract DEPLOY line from body: non-none → add ⚠️ marker
DEPLOY_MARKER=""
DEPLOY_LINE=$(printf "%s" "$BODY" | grep -i "^DEPLOY:" | sed 's/^[Dd][Ee][Pp][Ll][Oo][Yy]:[[:space:]]*//')
if [ -n "$DEPLOY_LINE" ]; then
  DEPLOY_NORMALIZED=$(printf "%s" "$DEPLOY_LINE" | tr '[:upper:]' '[:lower:]' | sed 's/[[:space:]]//g')
  if [ "$DEPLOY_NORMALIZED" != "none" ]; then
    DEPLOY_MARKER=$(printf "\n⚠️ 待确认：以下云函数是否已重新部署 → %s" "$DEPLOY_LINE")
  fi
fi

# Build entry from subject + body
BODY_TRIMMED=$(printf "%s" "$BODY" | sed '/^[[:space:]]*$/d')
ENTRY="## [$DATE] $HASH\n\n**$SUBJECT**"

if [ -n "$BODY_TRIMMED" ]; then
  ENTRY="$ENTRY\n\n$BODY_TRIMMED"
fi

ENTRY="$ENTRY\n\n**涉及文件:**\n$FILES$DEPLOY_MARKER"

# Warn if anything was masked
if [ "$MASKED" -eq 1 ]; then
  echo "WARNING: post-commit hook masked sensitive info in CHANGELOG.md entry" >&2
fi

TITLE=$(head -1 "$CHANGELOG")
REST=$(tail -n +2 "$CHANGELOG")
printf "%s\n\n%b\n%s" "$TITLE" "$ENTRY" "$REST" > "$CHANGELOG"
